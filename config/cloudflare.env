# Cloudflare Tunnel Configuration
# This file documents the Cloudflare setup for reference

# Tunnel Details
TUNNEL_NAME=sms-ingest
TUNNEL_HOSTNAME=qayd.io

# Service Configuration
SERVICE_TYPE=http
SERVICE_URL=host.docker.internal:8000

# Docker Command (for reference)
# docker run -d --name cloudflared --restart=always cloudflare/cloudflared:latest tunnel --token <YOUR_TOKEN>

# Webhook Endpoint
WEBHOOK_PATH=/webhook/sms
WEBHOOK_HEALTH_PATH=/webhook/health

# Notes:
# - WEBHOOK_SECRET is stored in backend/.env (not here for security)
# - Tunnel token is managed in Cloudflare Dashboard
# - Container name: nice_elion (or rename to cloudflared)
