# Copy this file to .env and fill in your values
# cp .env.example .env

# ===========================================
# DATABASE (usually set in docker-compose.yml)
# ===========================================
# Only needed if running outside Docker
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/finance_db

# ===========================================
# GEMINI AI CONFIGURATION
# ===========================================
# Get your API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Override the Gemini model (default is gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash-exp

# ===========================================
# TELEGRAM BOT CONFIGURATION (for SMS Agent)
# ===========================================
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Comma-separated list of Telegram user IDs allowed to use the bot
ALLOWED_TELEGRAM_USERS=123456789

# ===========================================
# AL RAJHI BANK OPEN BANKING API
# ===========================================
# Get credentials from https://developer.alrajhibank.com.sa/
ALRAJHI_API_KEY=your_alrajhi_api_key_here
ALRAJHI_API_SECRET=your_alrajhi_api_secret_here
ALRAJHI_REDIRECT_URI=https://your-domain.com/api/bank/callback

# Optional: Override API endpoints (defaults to Al Rajhi developer portal)
# ALRAJHI_API_BASE=https://developer.alrajhibank.com.sa/open-banking
# ALRAJHI_AUTH_URL=https://developer.alrajhibank.com.sa/open-banking/authorize
# ALRAJHI_TOKEN_URL=https://developer.alrajhibank.com.sa/open-banking/token
# ALRAJHI_API_ENDPOINT=https://developer.alrajhibank.com.sa/open-banking/v1
