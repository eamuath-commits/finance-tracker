# Copy this file to .env and fill in your values
# cp .env.example .env

# ===========================================
# TELEGRAM BOT CONFIGURATION (for SMS Agent)
# ===========================================
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ===========================================
# GEMINI AI CONFIGURATION
# ===========================================
# Get your API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Override the Gemini model (default is gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.0-flash-exp

# ===========================================
# DATABASE (usually set in docker-compose.yml)
# ===========================================
# Only needed if running outside Docker
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/finance_db
