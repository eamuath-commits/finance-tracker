# Root .env for docker-compose variable substitution.
# Copy to .env (git-ignored) and fill in. These are read by docker-compose.yml
# itself (not passed into the backend container — those live in backend/.env).

# Cloudflare Tunnel token (from the Cloudflare Zero Trust dashboard).
# REQUIRED for the cloudflared service to connect the public tunnel.
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token_here

# Public frontend URL (used for CORS allow-list and OAuth redirects).
FRONTEND_URL=https://your-domain.com

# Gemini model override (optional).
GEMINI_MODEL=gemini-2.5-flash

# Al Rajhi Open Banking (optional; also set in backend/.env for the app).
ALRAJHI_API_KEY=
ALRAJHI_API_SECRET=
ALRAJHI_REDIRECT_URI=https://your-domain.com/api/bank/callback
